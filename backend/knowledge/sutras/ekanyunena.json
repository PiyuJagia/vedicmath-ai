    {
      "concept_id": "sutra.ekanyunena.principle",
      "sutra_id": "ekanyunena",
      "title": "Why multiplying by 99/999 works this way",
      "concept_type": "principle",
      "difficulty_levels": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "prerequisites": [],
      "explanation": {
        "default": "Because 99=100−1, n×99=n(100−1)=100n−n. That equals (n−1)×100 + (100−n) after regrouping, which is exactly left=(n−1), right=(base−n).",
        "beginner": "7×99: left 6, right 93 → 693.",
        "derivation": "n(B−1)=nB−n=(n−1)B+(B−n)."
      },
