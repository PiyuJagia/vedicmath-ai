{"sutra":"Ekadhikena Purvena","numbers":[35,35],"difficulty":"beginner","teaching_steps":[{"step":1,"title":"Identify the number","explanation":"We want to calculate 35 squared."},{"step":2,"title":"Separate the last digit","explanation":"35 ends in 5. The preceding part is 3."},{"step":3,"title":"Add one to the preceding part","explanation":"3 + 1 = 4."},{"step":4,"title":"Multiply the two numbers","explanation":"3 × 4 = 12."},{"step":5,"title":"Append 25","explanation":"Append 25 to 12, giving 1225."},{"step":6,"title":"Final answer","explanation":"35² = 1225."}],"animation_steps":[{"action":"show_number","number":35},{"action":"highlight_last_digit","digit":5,"previous":3},{"action":"show_next_number","previous":3,"next_number":4},{"action":"multiply_previous","a":3,"b":4,"value":12},{"action":"append_25","left_part":12,"right_part":"25"},{"action":"reveal_result","result":1225}],"result":1225}