{"sutra":"Ekadhikena Purvena","numbers":[115,115],"difficulty":"intermediate","teaching_steps":[{"step":1,"title":"Identify the number","explanation":"We want to calculate 115 squared."},{"step":2,"title":"Separate the last digit","explanation":"115 ends in 5. The preceding part is 11."},{"step":3,"title":"Add one to the preceding part","explanation":"11 + 1 = 12."},{"step":4,"title":"Multiply the two numbers","explanation":"11 × 12 = 132."},{"step":5,"title":"Append 25","explanation":"Append 25 to 132, giving 13225."},{"step":6,"title":"Final answer","explanation":"115² = 13225."}],"animation_steps":[{"action":"show_number","number":115},{"action":"highlight_last_digit","digit":5,"previous":11},{"action":"show_next_number","previous":11,"next_number":12},{"action":"multiply_previous","a":11,"b":12,"value":132},{"action":"append_25","left_part":132,"right_part":"25"},{"action":"reveal_result","result":13225}],"result":13225}