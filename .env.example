# Copy this file to `.env` at the repository root and fill in real values.
# Never commit `.env` or real API keys.
#
# Used by Google ADK for local agent development (Gemini / Vertex AI).
# Production Render env vars for the agent are not configured in Phase 1.

# --- Gemini API (Google AI Studio) — simplest for local ADK ---
# Create a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Use the Gemini Developer API (AI Studio) instead of Vertex AI.
# Set to true only when using Vertex AI with Google Cloud credentials.
GOOGLE_GENAI_USE_VERTEXAI=false

# Connectivity smoke tests use gemini-3.8-flash via Google ADK
# (see backend.agents.gemini_connectivity). No model env var is required.
#
# Opt-in for live Gemini pytest suites (golden / teaching-quality / coach chat).
# Leave unset for offline-first regression. Requires funded AI Studio credits.
# VEDIC_LIVE_EVAL=1

# Feature flag: curated Vedic Maths knowledge retrieval for Rishi (Phase 7C).
# Leave unset/false until Phase 7C is approved for production coaching.
# VEDIC_KNOWLEDGE_RAG=1

# --- LangSmith tracing (Google ADK → LangSmith) ---
# Install: pip install "langsmith[google-adk]"
# Official integration: langsmith.integrations.google_adk.configure_google_adk
# Create an agent in LangSmith, then set AGENT_ID / ENVIRONMENT to match.
# Traces include Rishi turns, Gemini LLM calls, tool invocations, and errors.
# Requires LANGSMITH_API_KEY. Without a key, tracing stays off even if TRACING=true.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=vedicmath-ai-rishi
LANGSMITH_AGENT_ENVIRONMENT=local
# Label only. Runtime uses agent addressing and clears this env during configure
# to avoid LangSmith "project vs address" trace drops.
LANGSMITH_PROJECT=vedicmath-ai-rishi
# Production Render: LANGSMITH_AGENT_ENVIRONMENT=production
# Force redaction of custom-span learner I/O even outside production:
# VEDIC_LANGSMITH_REDACT_IO=true
# Create agent vedicmath-ai-rishi in LangSmith UI first; 403 means key/agent mismatch.


# --- Optional: Vertex AI on Google Cloud ---
# Required when GOOGLE_GENAI_USE_VERTEXAI=true.
# Also run: gcloud auth application-default login
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Existing FastAPI backend (unchanged; listed for local reference) ---
# Comma-separated browser origins allowed to call the API (CORS).
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (Vite) optional ---
# Force-enable the Tollgate 5B /coach-handoff harness outside local DEV.
# VITE_COACH_HANDOFF=true
